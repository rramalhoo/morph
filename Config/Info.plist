<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>morph.</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Morph</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Morph reads the current track from Apple Music or Spotify and sends play, pause and skip commands. It only contacts a player that is already running.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Morph analyzes the sound of your music player live so the island's bars move with the music. Audio is never recorded, saved or sent anywhere, and the microphone is not used.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_morphsync._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Morph Continuity lets an iPhone you paired with a QR code send its activities to this Mac over your local network. Nothing is sent to the internet.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Your Mac. More alive.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
