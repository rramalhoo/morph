// Shared build settings for Morph and its tests.
// Machine-specific signing lives in Local.xcconfig (git-ignored). See Local.xcconfig.example.

MACOSX_DEPLOYMENT_TARGET = 14.0
SDKROOT = macosx
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
CLANG_ENABLE_MODULES = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
GCC_NO_COMMON_BLOCKS = YES
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 1.0.0

// Ad-hoc by default so a fresh clone builds with no Apple Developer account.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

// The hardened runtime would block loading the unit test bundle into the host app.
ENABLE_HARDENED_RUNTIME = NO
ENABLE_HARDENED_RUNTIME[config=Release] = YES

#include? "Local.xcconfig"
